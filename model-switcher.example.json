{
  "$schema": "./model-switcher.schema.json",
  "defaults": {
    "providers": ["opencode", "opencode-go", "deepseek", "zai-coding-plan"],
    "long": 400000,
    "new": 20,
    "list": 30
  },
  "commands": {
    "oc-thinking": {
      "description": "Reasoning models on OpenCode, cheapest first",
      "filter": { "provider": "opencode", "think": true },
      "sort": "cheapest"
    },
    "oc-quick": {
      "description": "Fast, cheap edits",
      "model": "opencode/gemini-3.8-flash"
    },
    "oc-review": {
      "description": "Review on a frontier model with the plan agent",
      "model": "opencode/claude-opus-4-8",
      "agent": "plan"
    },
    "oc-zen": {
      "description": "Free OpenCode Zen models",
      "filter": { "provider": "opencode", "free": true }
    },
    "oc-variant-rich": {
      "description": "OpenCode models with the most variant settings",
      "filter": { "provider": "opencode" },
      "sort": "variants"
    }
  },
  "pairs": {
    "zen": {
      "description": "Free OpenCode models with a paid OpenCode fallback",
      "primary": { "free": true, "provider": "opencode" },
      "fallback": { "cheap": true, "provider": "opencode" }
    },
    "spark": {
      "primary": "opencode/muse-spark-1.3-contributor-free",
      "fallback": "opencode/muse-spark-1.3",
      "retry": true
    }
  }
}
